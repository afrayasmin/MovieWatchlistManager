<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.movieapp.controller.MovieListController">

    <top>
        <VBox spacing="10" styleClass="header">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>
            <Label text="Movie List" styleClass="title-label"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by title..." prefWidth="150"/>
                <Button text="Search" onAction="#handleSearch"/>
                <ComboBox fx:id="genreFilterCombo" prefWidth="110"/>
                <ComboBox fx:id="statusFilterCombo" prefWidth="100"/>
                <CheckBox fx:id="favoritesOnlyCheck" text="Favorites Only" textFill="WHITE"/>
                <Button text="Apply Filter" onAction="#handleFilter"/>
                <Button text="Reset" onAction="#handleReset" styleClass="button-secondary"/>
            </HBox>

            <Label fx:id="statusLabel" text="" styleClass="status-label"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="movieTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="280" minWidth="150"/>
                <TableColumn fx:id="genreColumn" text="Genre" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="yearColumn" text="Year" prefWidth="70" minWidth="55" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="ratingColumn" text="IMDb" prefWidth="70" minWidth="55" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="myRatingColumn" text="My Rating" prefWidth="90" minWidth="70" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="favoriteColumn" text="⭐" prefWidth="55" minWidth="45" style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="button-bar">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>
            <Button text="Add" onAction="#handleAdd"/>
            <Button text="Edit" onAction="#handleEdit"/>
            <Button text="Delete" onAction="#handleDelete" styleClass="button-danger"/>
            <Button text="Toggle Watched" onAction="#handleToggleStatus"/>
            <Button text="Toggle Favorite" onAction="#handleToggleFavorite"/>
            <Button text="Back to Dashboard" onAction="#handleBack" styleClass="button-secondary"/>
        </HBox>
    </bottom>

</BorderPane>